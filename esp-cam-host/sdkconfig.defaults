# ESP32-S3 N16R8: flash de 16 MB em QIO e PSRAM octal de 8 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# Log e console na UART0 (porta USB-UART, CH343). A USB nativa fica para a TinyBee.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y

# SD: nomes longos de arquivo
CONFIG_FATFS_LFN_HEAP=y

# Servidor web
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Console a 921600 (precisa da UART "custom" acima): a foto de teste vai pelo
# console em base64
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# A USB nativa (GPIO19/20) vira host para a TinyBee: o USB-Serial-JTAG divide o
# mesmo PHY e nao pode ficar como console secundario.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n

# Sockets (maximo do lwIP: 16): servidor principal 7 + 3 internos, video 2 + 3
# internos, e 1 para o DNS do portal e a nuvem. O padrao (10) nao comporta.
CONFIG_LWIP_MAX_SOCKETS=16
